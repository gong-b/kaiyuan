            拒绝.追加([sid, , "非资助对象"])
            continue
        如果词数 <config.REASON_MIN_WORDS:
            拒绝.追加([,name“字数不足{config.REASON_MIN_WORDS}”])
            继续

        接受.追加([sid, name, “通过”])

    # 录取25人
    接受 = 接受[:.MAX_ACCEPT]
    excel.写入接受(接受)
    excel.写入拒绝(拒绝)

    logging.info(f"\n🎯 录取：{len(accept)}人")
    logging.info("✅ 录取名单.xlsx 已生成")
